APP_NAME=Lab Formatter MVP
DEBUG=true

# SQLite локально: ничего в PostgreSQL создавать не нужно.
# Файл базы появится автоматически: Designer_Lab-backend/app.db
DATABASE_URL=sqlite:///./app.db

# Порты локальной связки:
# Backend №1: 8002
# Doc Service: 8000
# ML Service: 8001
BACKEND_PUBLIC_URL=http://127.0.0.1:8002
DOC_SERVICE_BASE_URL=http://127.0.0.1:8000
ML_SERVICE_BASE_URL=http://127.0.0.1:8001
DOC_SERVICE_TIMEOUT=900
ML_TIMEOUT=900

STORAGE_DIR=storage
INPUT_DIR=storage/inputs
OUTPUT_DIR=storage/outputs
REPORT_DIR=storage/reports
PROJECTS_DIR=storage/projects

AUTH_SECRET_KEY=change-me-in-dev
AUTH_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
